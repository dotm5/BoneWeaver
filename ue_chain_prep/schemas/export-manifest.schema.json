{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uecp://schema/export-manifest/4.0.0",
  "title": "UE Chain Prep Export Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "algorithm_version", "addon_version",
    "source_file_sha256", "source_file_timestamp", "plan_id", "graph_id", "profile", "tip_helper_usage",
    "armature", "bone_parents", "physics_edges", "physics_nodes", "snapshot_id", "whole_armature_post_digest", "whole_armature_post_state", "mesh_object_matrices",
    "tolerance_mode", "per_mesh_tolerance", "selected_bones", "target_bones",
    "mutation_targets", "reference_only_tip_helpers", "tip_helpers", "mutation_records",
    "branch_resolutions", "topology_ledger", "packed_image_count", "export_time"
  ],
  "properties": {
    "kind": {"const": "uecp.export_manifest"},
    "schema_version": {"const": "4.0.0"},
    "algorithm_version": {"type": "string"},
    "addon_version": {"type": "string"},
    "source_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_file_timestamp": {"type": "integer"},
    "plan_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "graph_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile": {"enum": ["BONEX_ROTATION_CHAIN", "BONEX_TRANSLATION_ALLOWED", "WIGGLE2_ROTATION_CHAIN", "WIGGLE2_STRETCH_CHAIN", "GEOMETRY_ONLY", "VISUAL_CHAIN_CLEANUP"]},
    "tip_helper_usage": {"enum": ["REFERENCE_ONLY", "INCLUDE_AS_PHYSICS_TERMINAL"]},
    "armature": {"type": "object", "additionalProperties": false, "required": ["object_name", "data_name", "matrix_world"], "properties": {"object_name": {"type": "string"}, "data_name": {"type": "string"}, "matrix_world": {"type": "array", "items": {"type": "number"}, "minItems": 16, "maxItems": 16}}},
    "bone_parents": {"type": "object"},
    "physics_edges": {"type": "array"},
    "physics_nodes": {"type": "array", "items": {"type": "object", "required": ["semantic_role", "reference_only", "mutation_target", "requires_own_tail"]}},
    "snapshot_id": {"type": ["string", "null"]},
    "whole_armature_post_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "whole_armature_post_state": {"type": "object"},
    "mesh_object_matrices": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number"}, "minItems": 16, "maxItems": 16}},
    "tolerance_mode": {"enum": ["AUTO_PRODUCTION", "STRICT_TEST", "CUSTOM"]},
    "per_mesh_tolerance": {"type": "array"},
    "maximum_delta": {"type": "number"},
    "rms_delta": {"type": "number"},
    "selected_bones": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "target_bones": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "mutation_targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reference_only_tip_helpers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tip_helpers": {"type": "array", "items": {"type": "object", "required": ["bone_name", "parent_bone_name", "role", "reference_only", "mutation_target", "requires_own_tail", "head", "tail", "parent_terminal_source"]}},
    "mutation_records": {"type": "array", "minItems": 1},
    "branch_resolutions": {"type": "array"},
    "automatic_terminal_count": {"type": "integer", "minimum": 0},
    "safe_fallback_terminal_count": {"type": "integer", "minimum": 0},
    "manual_terminal_count": {"type": "integer", "minimum": 0},
    "topology_ledger": {"type": "object", "required": ["selected_bone_count", "mutation_target_count", "reference_only_tip_helper_count", "proposal_count", "mutation_record_count", "skipped_by_design_count"]},
    "weight_digests": {"type": "object"},
    "base_mesh_digests": {"type": "object"},
    "modifier_digests": {"type": "object"},
    "packed_image_count": {"type": "integer", "minimum": 0},
    "export_time": {"type": "string"},
    "reopen_validation": {"type": "object"}
  }
}
