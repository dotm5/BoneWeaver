{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uecp://schemas/semantic-discovery-plan.schema.json",
  "title": "UECP Semantic Discovery Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "algorithm_version", "armature_object_name", "armature_fingerprint", "rule_set_ids", "chains", "bone_evidence", "excluded_bones", "ambiguous_bones"],
  "properties": {
    "kind": {"const": "SEMANTIC_DISCOVERY_PLAN"},
    "schema_version": {"const": "1.0.0"},
    "algorithm_version": {"type": "string"},
    "armature_object_name": {"type": "string"},
    "armature_fingerprint": {"type": "string"},
    "rule_set_ids": {"$ref": "#/$defs/stringArray"},
    "chains": {"type": "array", "items": {"$ref": "#/$defs/chain"}},
    "bone_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "excluded_bones": {"$ref": "#/$defs/stringArray"},
    "ambiguous_bones": {"$ref": "#/$defs/stringArray"}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "chain": {"type": "object", "additionalProperties": false, "required": ["discovery_id", "root_bone_name", "bone_names", "category", "discovery_class", "discovery_score", "needs_projection_count", "already_valid_count", "branch_bone_names", "leaf_bone_names", "reason_codes"], "properties": {"discovery_id": {"type": "string"}, "root_bone_name": {"type": "string"}, "bone_names": {"$ref": "#/$defs/stringArray"}, "category": {"type": "string"}, "discovery_class": {"type": "string"}, "discovery_score": {"type": "number"}, "needs_projection_count": {"type": "integer"}, "already_valid_count": {"type": "integer"}, "branch_bone_names": {"$ref": "#/$defs/stringArray"}, "leaf_bone_names": {"$ref": "#/$defs/stringArray"}, "reason_codes": {"$ref": "#/$defs/stringArray"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["bone_name", "normalized_name", "semantic_stem", "category", "semantic_tokens", "side", "sequence_index", "semantic_score", "hierarchy_score", "sequence_score", "weight_score", "geometry_mismatch_score", "metadata_score", "exclusion_penalty", "reason_codes", "geometry_projection_need"], "properties": {"bone_name": {"type": "string"}, "normalized_name": {"type": "string"}, "semantic_stem": {"type": "string"}, "category": {"type": "string"}, "semantic_tokens": {"$ref": "#/$defs/stringArray"}, "side": {"type": ["string", "null"]}, "sequence_index": {"type": ["integer", "null"]}, "semantic_score": {"type": "number"}, "hierarchy_score": {"type": "number"}, "sequence_score": {"type": "number"}, "weight_score": {"type": "number"}, "geometry_mismatch_score": {"type": "number"}, "metadata_score": {"type": "number"}, "exclusion_penalty": {"type": "number"}, "reason_codes": {"$ref": "#/$defs/stringArray"}, "geometry_projection_need": {"type": "string"}}}
  }
}
