{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boneweaver://schemas/semantic-discovery-plan/2.0.0",
  "title": "BONEWEAVER Semantic Discovery Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "algorithm_version", "armature_object_name",
    "armature_fingerprint", "rule_set_ids", "chains", "bone_evidence",
    "excluded_bones", "ambiguous_bones"
  ],
  "properties": {
    "kind": {"const": "SEMANTIC_DISCOVERY_PLAN"},
    "schema_version": {"const": "2.0.0"},
    "algorithm_version": {"const": "semantic-discovery-v0.2.0"},
    "armature_object_name": {"type": "string"},
    "armature_fingerprint": {"type": "string", "minLength": 1},
    "rule_set_ids": {"$ref": "#/$defs/uniqueStringArray"},
    "chains": {"type": "array", "items": {"$ref": "#/$defs/chain"}},
    "bone_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "excluded_bones": {"$ref": "#/$defs/uniqueStringArray"},
    "ambiguous_bones": {"$ref": "#/$defs/uniqueStringArray"}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "uniqueStringArray": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reasonCodes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^BONEWEAVER_[A-Z0-9_]+$"},
      "uniqueItems": true
    },
    "category": {
      "enum": [
        "HAIR", "RIBBON", "SKIRT", "CLOAK", "CAPE", "TAIL", "EARRING",
        "STRAP", "BELT", "SCARF", "TASSEL", "ACCESSORY", "BAG",
        "CHEST_SECONDARY", "UNKNOWN_SECONDARY", "MAIN_SKELETON", "SOCKET",
        "IK_CONTROL", "TWIST_DEFORM", "FACIAL", "BAG_OR_STRAP", "CLOTH",
        "PHYSICS_EXPLICIT"
      ]
    },
    "discoveryClass": {"enum": ["AUTO_INCLUDE", "SUGGEST_INCLUDE", "AMBIGUOUS", "EXCLUDE"]},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_id", "root_bone_name", "bone_names", "category",
        "discovery_class", "discovery_score", "needs_projection_count",
        "already_valid_count", "branch_bone_names", "leaf_bone_names",
        "reason_codes"
      ],
      "properties": {
        "discovery_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "root_bone_name": {"type": "string", "minLength": 1},
        "bone_names": {"$ref": "#/$defs/uniqueStringArray"},
        "category": {"$ref": "#/$defs/category"},
        "discovery_class": {"$ref": "#/$defs/discoveryClass"},
        "discovery_score": {"$ref": "#/$defs/score"},
        "needs_projection_count": {"type": "integer", "minimum": 0},
        "already_valid_count": {"type": "integer", "minimum": 0},
        "branch_bone_names": {"$ref": "#/$defs/uniqueStringArray"},
        "leaf_bone_names": {"$ref": "#/$defs/uniqueStringArray"},
        "reason_codes": {"$ref": "#/$defs/reasonCodes"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bone_name", "normalized_name", "semantic_stem", "category",
        "semantic_tokens", "side", "sequence_index", "semantic_score",
        "hierarchy_score", "sequence_score", "weight_score",
        "geometry_mismatch_score", "metadata_score", "exclusion_penalty",
        "reason_codes", "geometry_projection_need", "discovery_class",
        "discovery_score"
      ],
      "properties": {
        "bone_name": {"type": "string", "minLength": 1},
        "normalized_name": {"type": "string"},
        "semantic_stem": {"type": "string"},
        "category": {"$ref": "#/$defs/category"},
        "semantic_tokens": {"$ref": "#/$defs/stringArray"},
        "side": {"enum": ["LEFT", "RIGHT", null]},
        "sequence_index": {"type": ["integer", "null"], "minimum": 0},
        "semantic_score": {"$ref": "#/$defs/score"},
        "hierarchy_score": {"$ref": "#/$defs/score"},
        "sequence_score": {"$ref": "#/$defs/score"},
        "weight_score": {"$ref": "#/$defs/score"},
        "geometry_mismatch_score": {"$ref": "#/$defs/score"},
        "metadata_score": {"$ref": "#/$defs/score"},
        "exclusion_penalty": {"$ref": "#/$defs/score"},
        "reason_codes": {"$ref": "#/$defs/reasonCodes"},
        "geometry_projection_need": {"enum": ["REQUIRED", "RECOMMENDED", "NOT_REQUIRED", "UNRESOLVED"]},
        "discovery_class": {"$ref": "#/$defs/discoveryClass"},
        "discovery_score": {"$ref": "#/$defs/score"}
      }
    }
  }
}
