{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boneweaver://schema/diagnostic-report/4.0.0",
  "title": "BoneWeaver Diagnostic Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "algorithm_version", "addon_version", "environment", "plan_id", "physics_graph_id", "profile", "tip_helper_usage", "physics_nodes", "snapshot_id", "issues", "chains", "terminal_candidates", "weight_statistics", "tip_helpers", "segment_sampling_hints", "branch_resolutions", "topology_ledger", "validation", "performance", "side_effect_audit"],
  "properties": {
    "kind": {"const": "boneweaver.diagnostic_report"},
    "schema_version": {"const": "4.0.0"},
    "algorithm_version": {"type": "string"},
    "addon_version": {"type": "string"},
    "environment": {"type": "object"},
    "plan_id": {"type": ["string", "null"]},
    "physics_graph_id": {"type": ["string", "null"]},
    "profile": {"enum": ["BONEX_ROTATION_CHAIN", "BONEX_TRANSLATION_ALLOWED", "WIGGLE2_ROTATION_CHAIN", "WIGGLE2_STRETCH_CHAIN", "GEOMETRY_ONLY", "VISUAL_CHAIN_CLEANUP"]},
    "tip_helper_usage": {"enum": ["REFERENCE_ONLY", "INCLUDE_AS_PHYSICS_TERMINAL"]},
    "physics_nodes": {"type": "array", "items": {"type": "object", "required": ["semantic_role", "reference_only", "mutation_target", "requires_own_tail"]}},
    "snapshot_id": {"type": ["string", "null"]},
    "issues": {"type": "array"},
    "chains": {"type": "array"},
    "terminal_candidates": {"type": "array"},
    "weight_statistics": {"type": "array"},
    "tip_helpers": {"type": "array", "items": {"type": "object", "required": ["bone_name", "parent_bone_name", "role", "reference_only", "mutation_target", "requires_own_tail", "head", "tail", "parent_terminal_source"]}},
    "segment_sampling_hints": {"type": "array"},
    "branch_resolutions": {"type": "array"},
    "topology_ledger": {"type": ["object", "null"], "required": ["selected_bone_count", "mutation_target_count", "reference_only_tip_helper_count", "proposal_count", "mutation_record_count", "skipped_by_design_count"]},
    "validation": {"type": "object"},
    "performance": {"type": "object"},
    "side_effect_audit": {"type": "object"}
  }
}
