{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boneweaver://schemas/semantic-rule-set.schema.json",
  "title": "BONEWEAVER Semantic Rule Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_set_id", "rule_set_version", "display_name", "include_tokens", "exclude_tokens", "category_rules", "sequence_patterns", "main_skeleton_patterns", "metadata_rules"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "rule_set_id": {"type": "string", "minLength": 1},
    "rule_set_version": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "include_tokens": {"$ref": "#/$defs/includeTokens"},
    "exclude_tokens": {"$ref": "#/$defs/excludeTokens"},
    "category_rules": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/categoryName"},
      "additionalProperties": {"$ref": "#/$defs/categoryRule"}
    },
    "sequence_patterns": {"$ref": "#/$defs/stringArray"},
    "main_skeleton_patterns": {"$ref": "#/$defs/stringArray"},
    "metadata_rules": {"type": "object", "additionalProperties": {"$ref": "#/$defs/categoryName"}}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "includeTokens": {"type": "object", "additionalProperties": false, "required": ["strong", "medium", "generic"], "properties": {"strong": {"$ref": "#/$defs/stringArray"}, "medium": {"$ref": "#/$defs/stringArray"}, "generic": {"$ref": "#/$defs/stringArray"}}},
    "excludeTokens": {"type": "object", "additionalProperties": false, "required": ["main_skeleton", "socket", "ik_control", "twist_deform", "facial"], "properties": {"main_skeleton": {"$ref": "#/$defs/stringArray"}, "socket": {"$ref": "#/$defs/stringArray"}, "ik_control": {"$ref": "#/$defs/stringArray"}, "twist_deform": {"$ref": "#/$defs/stringArray"}, "facial": {"$ref": "#/$defs/stringArray"}}},
    "categoryName": {
      "enum": [
        "HAIR", "RIBBON", "SKIRT", "CLOAK", "CAPE", "TAIL", "EARRING",
        "STRAP", "BELT", "SCARF", "TASSEL", "ACCESSORY", "BAG",
        "CHEST_SECONDARY", "UNKNOWN_SECONDARY", "MAIN_SKELETON", "SOCKET",
        "IK_CONTROL", "TWIST_DEFORM", "FACIAL", "BAG_OR_STRAP", "CLOTH",
        "PHYSICS_EXPLICIT"
      ]
    },
    "categoryRule": {"type": "object", "additionalProperties": false, "required": ["tokens", "maximum_class"], "properties": {"tokens": {"$ref": "#/$defs/stringArray"}, "maximum_class": {"enum": ["AUTO_INCLUDE", "SUGGEST_INCLUDE", "AMBIGUOUS", "EXCLUDE"]}}}
  }
}
